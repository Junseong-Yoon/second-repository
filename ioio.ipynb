    "import pandas as pd\n",
    "\n",
    "# 예시 데이터 만들기\n",
    "data = {\n",
    "    \"이름\": [\"철수\", \"영희\", \"민수\"],\n",
    "    \"나이\": [25, 22, 30],\n",
    "    \"도시\": [\"서울\", \"부산\", \"인천\"]\n",
    "}\n",
    "\n",
    "df = pd.DataFrame(data)\n",
    "\n",
    "print(df)\n",
    "print(\"\\n나이 평균:\", df[\"나이\"].mean())\n",
    "\n",
    "#업로드 연습하는데 오류계속나온다"
   ]
  }
